# URL do backend, usada apenas pelo servidor do Next (rotas /api/auth e
# /api/proxy). Nunca é exposta ao navegador.
#
# Rodando via Docker Compose, o host é o nome do serviço:
#   API_BASE_URL=http://backend:8080
# Rodando o frontend direto na máquina:
#   API_BASE_URL=http://localhost:8080
API_BASE_URL=http://localhost:8080

# URL pública da aplicação, usada em metadados.
NEXT_PUBLIC_APP_URL=http://localhost:3000
