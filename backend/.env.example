# Ambiente: development | production
# Em production o log sai em JSON; em development, em texto legivel.
APP_ENV=development

# Porta HTTP do servidor.
HTTP_PORT=8080

# String de conexao do PostgreSQL.
# Rodando fora do Docker, troque "postgres" por "localhost".
DATABASE_URL=postgres://finapp:finapp@postgres:5432/finapp?sslmode=disable

# Segredo de assinatura dos access tokens (HS256).
# OBRIGATORIO e com no minimo 32 caracteres. Gere o seu com:
#   openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-48-bytes

# Validade dos tokens. Aceita duracao Go ("15m", "168h") ou segundos.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Origens autorizadas a chamar a API pelo navegador, separadas por virgula.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Nivel de log: debug | info | warn | error
LOG_LEVEL=info

# Prefixo das chaves de API geradas em Configuracoes > Integracoes.
API_KEY_PREFIX=fin_live

# Caminho da especificacao OpenAPI servida em /docs.
OPENAPI_PATH=docs/openapi.yaml
