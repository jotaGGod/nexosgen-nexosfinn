# Copie para .env.prod exclusivamente no servidor de produção e gere valores
# aleatórios para POSTGRES_PASSWORD e JWT_SECRET. Nunca versione .env.prod.
APP_ENV=production
HTTP_PORT=8080
POSTGRES_USER=nexosfinn
POSTGRES_PASSWORD=troque-por-um-segredo-aleatorio
POSTGRES_DB=nexosfinn
DATABASE_URL=postgres://nexosfinn:troque-por-um-segredo-aleatorio@postgres:5432/nexosfinn?sslmode=disable
JWT_SECRET=troque-por-um-segredo-aleatorio-com-ao-menos-32-caracteres
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
CORS_ALLOWED_ORIGINS=https://nexosfinn.nexosgen.com.br
LOG_LEVEL=info
API_KEY_PREFIX=nfh_live
